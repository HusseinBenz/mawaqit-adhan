<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Compile Include="../../src/MawaqitAdhan/Core/*.cs" />
    <Compile Include="../../src/MawaqitAdhan/Ui/*.cs" />
    <EmbeddedResource Include="../../src/MawaqitAdhan/Core/windows-zones.tsv" />
    <Content Include="../../assets/audio/bip.mp3" Link="audio/bip.mp3" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
