<Project>
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/*.sync-conflict-*</DefaultItemExcludes>
    <WindowsMediaSdkVersion Condition="'$(WindowsMediaSdkVersion)' == ''">10.0.26100.0</WindowsMediaSdkVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Windows">
      <HintPath>$(MSBuildProgramFiles32)/Windows Kits/10/UnionMetadata/$(WindowsMediaSdkVersion)/Windows.winmd</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime.WindowsRuntime">
      <HintPath>$(SystemRoot)/Microsoft.NET/Framework/v4.0.30319/System.Runtime.WindowsRuntime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
